<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*" Name="Threat Atlas SOC" Language="1033" Version="0.4.8"
           Manufacturer="Ibert Consulting" UpgradeCode="9D690E47-8F57-4B7C-BB7E-C9DA787FE981">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perMachine" InstallPrivileges="elevated" />
    <MajorUpgrade DowngradeErrorMessage="A newer Threat Atlas version is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Property Id="WINDOWSBUILD">
      <RegistrySearch Id="WindowsBuildSearch" Root="HKLM" Key="SOFTWARE\Microsoft\Windows NT\CurrentVersion" Name="CurrentBuildNumber" Type="raw" Win64="yes" />
    </Property>
    <Condition Message="Threat Atlas requires 64-bit Windows 10 or later.">Installed OR (VersionNT64 AND WINDOWSBUILD &gt;= 10240)</Condition>
    <Property Id="PERUSERINSTALL">
      <RegistrySearch Id="PerUserInstallSearch" Root="HKCU" Key="Software\Ibert Consulting\ThreatAtlas" Name="InstallPath" Type="raw" />
    </Property>
    <!-- Windows Installer does not upgrade across install contexts, so an old per-user copy would stay behind. -->
    <Condition Message="Uninstall the older per-user Threat Atlas SOC from Settings &gt; Apps, then run this installer again.">Installed OR NOT PERUSERINSTALL</Condition>
    <Property Id="ARPNOMODIFY" Value="1" />
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="System64Folder">
        <!-- One x64 copy where Screen Saver Settings lists it. 64-bit component: never redirected to SysWOW64. -->
        <Component Id="SaverComponent" Guid="2E4DC2FB-DF8E-48D7-8B61-D79797773BA4" Win64="yes">
          <File Id="ScreenSaver" Source="dist/ThreatAtlas.scr" KeyPath="yes" />
        </Component>
      </Directory>
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="Threat Atlas">
          <Component Id="DocsComponent" Guid="7EC8A941-A918-475A-9D1F-7D3D563C4C18" Win64="yes">
            <File Id="SetupGuide" Source="installer/INSTALL.txt" KeyPath="no" />
            <File Id="ThirdPartyNotices" Source="THIRD-PARTY-NOTICES.txt" />
            <File Id="FontLicense" Source="assets/FONT-LICENSE.txt" />
            <File Id="AssetAttribution" Source="assets/ATTRIBUTION.md" />
            <File Id="PrivacyPolicy" Source="PRIVACY.md" />
            <File Id="LicenseFile" Source="LICENSE" Name="LICENSE.txt" />
            <RegistryValue Root="HKLM" Key="Software\Ibert Consulting\ThreatAtlas" Name="DocsVersion" Value="0.4.8" Type="string" KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="AppMenu" Name="Threat Atlas SOC">
          <Component Id="MenuComponent" Guid="2C7A3436-A7EC-4328-9D44-98E842B0FA88" Win64="yes">
            <Shortcut Id="SelectSaver" Name="Set up Threat Atlas" Target="[System64Folder]rundll32.exe" Arguments="desk.cpl,InstallScreenSaver &quot;[#ScreenSaver]&quot;" WorkingDirectory="INSTALLFOLDER" />
            <Shortcut Id="PreviewSaver" Name="Preview Threat Atlas" Target="[#ScreenSaver]" Arguments="--windowed" WorkingDirectory="INSTALLFOLDER" />
            <Shortcut Id="ReadGuide" Name="Installation instructions" Target="[#SetupGuide]" WorkingDirectory="INSTALLFOLDER" />
            <RemoveFolder Id="RemoveAppMenu" On="uninstall" />
            <RegistryValue Root="HKLM" Key="Software\Ibert Consulting\ThreatAtlas" Name="MenuInstalled" Value="1" Type="integer" KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>
    </Directory>
    <InstallExecuteSequence>
      <RemoveExistingProducts After="InstallInitialize" />
    </InstallExecuteSequence>
    <Feature Id="Complete" Title="Threat Atlas SOC" Level="1">
      <ComponentRef Id="SaverComponent" /><ComponentRef Id="DocsComponent" /><ComponentRef Id="MenuComponent" />
    </Feature>
  </Product>
</Wix>
